{
  "name": "emily",
  "version": "0.1.0",
  "description": "A REST API built with Bun, Express, TypeScript, and MongoDB",
  "author": "Clovis Mugaruka <clovis.mugaruka@gmail.com>",
  "license": "MIT",
  "module": "app/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch app/index.ts",
    "start": "bun app/index.ts",
    "clean": "rm -rf node_modules .cache",
    "reinstall": "bun run clean && bun install",
    "typecheck": "bun tsc"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "mongoose": "^9.6.3"
  }
}
